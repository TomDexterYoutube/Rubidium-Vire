# =========================================
# OS
# =========================================

use os

# Start a hidden terminal session with an integer ID.
# On Linux this opens a bash shell.
# On Windows this opens cmd or powershell depending on your system.
# The terminal is not visible — it is for Rubidium only.

os.start(1)

# Run a command in a terminal session:

os.run(1, "ls -a")

# Capture command output:

let output = os.run(1, "echo hello")

# Pass input automatically when the command asks for it:
# The third argument is sent as soon as input is requested.

let result = os.run(1, "sudo apt update", "y")

# os.run waits for the command to actually finish before returning, so
# slow or bursty output (e.g. a streaming download) is captured in full,
# not truncated. There is a generous default safety limit (5 minutes) so a
# hung command cannot block forever.

# The struct form accepts an optional `timeout` (in SECONDS) to override
# that safety limit — useful to bound a command you don't want to wait on:

let data = os.run({cmd: "curl -s https://example.com", timeout: 30})

# The struct form also supports `args` (a list appended to the command) and
# `input` (sent to the command's stdin), and defaults to terminal 0:

let listing = os.run({cmd: "ls", args: ["-l", "/tmp"]})

# Drop a terminal session to free its resources:

os(1).drop()


# =========================================
# CONVERSION
# =========================================

# Conversion between Rubidium (Vire) types and LIB (C) types. cast.X(value)
# and retrieve.X(value) are the same underlying operation — X is the
# TARGET type either way — named differently only so the direction reads
# naturally at the call site: cast when you're headed OUT toward a LIB
# type, retrieve when you're headed back IN toward a Rubidium type.

# X is a method name, so it can't be spelled exactly like a multi-word LIB
# type ("unsigned int") or one with a literal '*' in it ("char*") — those
# get their own single-word name below instead. Every other LIB type
# keeps its own name unchanged (cast.int, cast.long, cast.double, ...).
#
#   char* -> cstr        void* -> voidptr     ptr -> ptr (unchanged)
#   unsigned char  -> uchar     signed char -> schar
#   unsigned short -> ushort    unsigned int -> uint
#   unsigned long  -> ulong     long long -> longlong
#   unsigned long long -> ulonglong    long double -> longdouble
#   int8_t/uint8_t   -> int8/uint8      int16_t/uint16_t -> int16/uint16
#   int32_t/uint32_t -> int32/uint32    int64_t/uint64_t -> int64/uint64
#   int128_t/uint128_t -> int128/uint128
#   size_t/ptrdiff_t/intptr_t/uintptr_t -> unchanged

# NO-OP CASTS ARE REJECTED: a LIB numeric type whose representation is
# already IDENTICAL to the source value's own Rubidium type needs no
# conversion at all — that value is already directly usable wherever the
# LIB type is expected (see DATA TYPES > LIB / doesn't-need-conversion
# below). cast.X()/retrieve.X() is a compile error in that case, not a
# silent pass-through:
#
#   let a: i32 = 42
#   let b = cast.int(a)     # Type Error — a is already int-shaped (i32);
#                            # pass `a` straight into the FFI call instead
#
# A genuine width change is still a real conversion and works normally:
let a: i64 = 5000000000
let b = cast.int(a)   # narrows i64 -> int (i32), clamps to range

# LIB pointer -> Rubidium Any (retrieve, since it's headed back in):
let raw_ptr = cast.voidptr(Null)
let any_val: Any = retrieve.Any(raw_ptr)

# Narrowing between numeric sizes — same overflow clamping as `as`:
let x: i64 = 10000000000
let y = cast.i32(x)   # narrows, clamps to i32's range

# Rubidium str <-> LIB char* — cstr and str already share the exact same
# representation, so this direction never actually loses/reshapes data:
let s: str = "hello"
let cs = cast.cstr(s)
let back: str = retrieve.str(cs)

# -----------------------------------------
# BUFFERS
# -----------------------------------------

# Rubidium's own list/dict/etc have no raw C layout — cast.list(list,
# elem_type) is the one exception, flattening a list into a raw contiguous
# C array (a `const void* data` parameter, e.g. glBufferData). Same method
# name as the 1-arg cast.list(x) above (CONVERSION's ordinary Any/box
# relabel) — the 2-argument form is a completely different operation
# (actually walks and flattens the list), disambiguated purely by how many
# arguments you pass. elem_type is a bare type keyword (i32/f32/int/
# float/...), not a string; only i32/i64/f32/f64-width int/float types are
# supported (the widths a real C ABI actually uses) — the equivalent LIB
# types (int/long/float/double, or the matching intN_t) work exactly the
# same:

let verts: list: f32 = [0.0, 1.0, 0.0, -1.0, -1.0, 0.0]
let buf = cast.list(verts, f32)

# retrieve.list(ptr, elem_type, count) is the reverse — reads `count`
# elements of elem_type width back out of a raw buffer into a real
# Rubidium list (same "1 arg = relabel, 3 args = real work" disambiguation
# as cast.list above). This is also how you read an out-parameter a C
# function wrote into (glGenBuffers(n, &buffers)-style APIs): pass it a
# placeholder list of the right length so cast.list() gives you a buffer to
# hand the C function, then retrieve.list() the same pointer afterward to
# see what it wrote:

let mut placeholder: list: i32 = [0, 0, 0]
let out_buf = cast.list(placeholder, i32)
# some_c_fn(out_buf, 3)   -- writes 3 ints into out_buf
let results: list = retrieve.list(out_buf, i32, 3)

# Notes:
# - cast.X(value) / retrieve.X(value) are the same operation; the
#   direction in the name is a readability convention, not enforced.
# - Conversions that may lose precision must be explicit, same as `as`.
# - Null can be cast to any pointer type.


# =========================================
# FFI — FOREIGN FUNCTION INTERFACE
# =========================================

# A binding's parameter/return types can be Rubidium types OR LIB types,
# mixed freely in the same signature — which one you use depends on what's
# actually on the other side of FFI("..."):

# Loaded library is ITSELF Rubidium-compiled (built by this same compiler
# with `-s`) — both sides share the exact same %Box* layout, so most real
# Rubidium types cross directly, no conversion:

let lib = FFI("lib.so")

fn lib lib_fn(var: i32, var2: str) as fnut

fnut(1, "hello")

# dict/dict+/index are the exception — they can NEVER cross an FFI
# boundary, not even to another Rubidium-compiled .so. There's no way for
# the compiler to tell at compile time whether the other side of
# FFI("...") really is a Rubidium binary or a genuine foreign C library
# that has no idea what a %Box* is, so these are rejected outright:
#
#   fn lib lib_fn(var2: dict+) as fnut   # Type Error — always, no exceptions
#
# list is similar but has a real conversion route — see BUFFERS above —
# so it's rejected as a DIRECT binding parameter/return type but must
# instead be flattened first with cast.list(list, elem_type)/
# retrieve.list(ptr, elem_type, count):
#
#   fn lib lib_fn(var2: list) as fnut    # Type Error
#   let buf = cast.list(my_list, i32)
#   fn lib lib_fn(var2: void*) as fnut   # fine — buf is what actually crosses

# Loaded library is a genuine foreign C library — its functions only know
# about LIB types (see DATA TYPES > LIB), so the binding is written in
# those instead:

let glfw = FFI("libglfw.so")

fn glfw glfwInit() -> int as glfw_init
fn glfw glfwCreateWindow(width: int, height: int, title: char*, monitor: void*, share: void*) -> void* as create_window
fn glfw glfwGetTime() -> double as get_time

fn main() {
    glfw_init()
    let win = create_window(800, 600, "Hello Vire", Null, Null)
    let t = get_time()
}

# -----------------------------------------
# BINDING AGAINST A RESOLVED ADDRESS
# -----------------------------------------

# `fn lib symbol(...) as alias` looks a name up in a loaded library (dlsym,
# effectively) — fine for a function that's always exported under a fixed
# name. Some APIs don't work that way: OpenGL past the oldest baseline
# functions has to be fetched at RUNTIME, by asking the driver "where is
# glGenBuffers right now" and getting back a raw address instead of
# anything you could look up by name a second time.

# Getting the address is an ordinary binding — it's just a function that
# happens to return a `ptr`:

fn glfw glXGetProcAddress(name: char*) -> ptr as get_proc_address

# Store it, typed as `ptr`, then bind directly against THAT — `fn ptr
# <variable>(...)` instead of `fn <lib> <symbol>(...)`. No name lookup at
# all this time; the variable already IS the address to call through:

let raw: ptr = get_proc_address("glGenBuffers")
fn ptr raw(n: int, buffers: void*) as gen_buffers

gen_buffers(1, out_buf)

# `as alias` is required here (there's no symbol name to fall back to,
# unlike the dlsym form). Everything else — parameter/return types,
# calling it afterward — works exactly like any other binding.

# -----------------------------------------
# FFI FUNCTION RENAMING
# -----------------------------------------

# External libraries often have ugly names:

# calculate_vector3_fast()
# rb_internal_math_v2()
# _ZN12SomethingFoo...

# Rubidium can expose cleaner names.

let math_lib = FFI("libs/math.so")

fn math_lib rb_sin(x: f64) -> f64 as sin

print(sin(0.5))

# -----------------------------------------
# FFI WRAPPERS
# -----------------------------------------

# Foreign functions can be wrapped normally.

fn math_lib rb_sqrt(x: f64) -> f64 as raw_sqrt

fn sqrt(value: f64) -> f64 {
    return math_lib.raw_sqrt(value)
}

# -----------------------------------------
# IMPORTING FFI WRAPPERS
# -----------------------------------------

# math_tools.vire

let native = FFI("libs/math.so")

fn native native_sin(x: f64) -> f64 as sin

fn native_sqrt(x: f64) -> f64 as sqrt

# another_file.vire

import math_tools as mt

mt.sin(1.0)
mt.sqrt(25.0)

# -----------------------------------------
# FFI CALLBACKS
# -----------------------------------------

# Everything the FFI section above does is Vire being the one in charge —
# you call a C function, it runs, it hands an answer back, done. A callback
# flips that around: you're telling a C library "here's a piece of code —
# don't run it now, hang onto it, and call it YOURSELF later, whenever
# something happens." GLFW doesn't know when you're going to press a key.
# So instead, you hand GLFW the address of a function ahead of time, and
# GLFW calls it the instant a key is pressed — possibly seconds or minutes
# from now, from code you don't control the timing of at all.

# Why this needs its own keyword instead of just "get the address": an
# ordinary Vire function is compiled expecting to be called BY OTHER VIRE
# CODE, which quietly sets a few things up every time a function is
# called — memory bookkeeping, and a way to report errors back up the
# chain. If C just called your function's raw address directly, none of
# that setup would happen. `fn callback` builds a small C-ABI "receptionist"
# in front of your function that does Vire's setup first, then calls your
# real code, every single time C calls in.

# `fn callback` is just like a normal `fn` — the ONLY difference is the
# word `callback` right after `fn`. `callback` is a reserved word, same as
# `local`/`open`/`file`.

# The parameter types here are NOT your choice — they have to match EXACTLY
# what the C library's own documentation says it will pass to your
# function, so this is one of the few places you'll usually reach for LIB
# types rather than Rubidium ones (see DATA TYPES > LIB):

fn callback my_key_handler(key: int, action: int) {
    print(i"key pressed: {key}")
}

# Handing GLFW the callback: write the function's NAME, with no
# parentheses and no arguments. Parentheses would CALL it right now, today,
# once — which isn't what you want. Leaving them off means "here's the
# function itself, hang onto it and call it yourself later." Everywhere
# else in Vire, a bare function name with no call is an error — but for a
# name declared with `fn callback`, it's how you hand it off. The
# parameter it's handed into is just `void*` (or whatever LIB pointer type
# the C function's own signature declares for it) — a function pointer is
# a pointer at the ABI level, same as any other:

fn glfw glfwSetKeyCallback(window: void*, cb: void*) as set_key_callback

set_key_callback(win, my_key_handler)

# From this point on, you don't call my_key_handler yourself at all — GLFW
# does, on its own schedule, every time a key event happens. Nothing else
# about writing the function's BODY is different from any other Vire
# function — print(), global variables, cast()/retrieve(), everything
# works normally inside it.

# Rules:
# - Use `fn callback` instead of plain `fn` ONLY for a function you're
#   going to hand to a C library as an event handler. Every other function
#   stays exactly as `fn` as always.
# - The parameter types and return type must match what the C library will
#   actually call your function with — the compiler cannot check this for
#   you, the same way it can't check a regular FFI binding's signature.
# - Write the function name with NO parentheses when handing it to a C
#   library expecting a callback. With parentheses, it's an ordinary
#   function call, right now, once.


# =========================================
# NOTES
# =========================================

# Syntax:
#   - Statements end with a newline
#   - Semicolons are not required
#   - Blocks use braces { }
#   - Comments use #
#   - Strings use double quotes
#   - String interpolation uses: i"text {variable}"
#   - Boolean values are True and False
#   - Logical operators are: and, or, not
#   - Type casting uses: as
#   - Square root uses: */value

# Memory:
#   - All assignments create a full deep copy
#   - Values are never borrowed or shared
#   - Variables live in the global pool by default
#   - Memory must be freed manually with .drop()
#   - Accessing dropped memory causes a runtime error
#   - Loop variables are automatically dropped when the loop ends
#   - File handles are automatically dropped when an open() block ends
#   - Global memory must be freed manually with .drop()
#   - Temporary scoped values are dropped automatically
#   - Null is a valid value for all types (exists but empty)
#   - Null == Null is True


# Global Variables:
#   - Variables declared without local enter the global memory pool
#   - Global variables remain alive until dropped
#   - Global variables are accessible from functions and threads
#   - Global variables may be shadowed by local variables

# Assignment:
#   - Assignment copies values
#   - Assignment never creates references, by default
#   - Assignment never transfers ownership
#   - Assignment always creates an independent value
#   - The only exception is 'link', which explicitly opts a variable
#     into sharing instead of copying (see THE LINK RULE)

# Scope:
#   - Variables created at the top level are visible everywhere
#   - Functions can access global variables
#   - Function parameters exist only for the lifetime of the function
#   - Classes create their own scope
#   - Imported files create their own namespace
#   - Symbols are resolved from the nearest scope outward
#   - Local scope always takes priority over global scope

# Functions:
#   - Function names must be unique within a scope
#   - Duplicate function definitions cause compile errors
#   - Function overloading is not supported
#   - Functions may access global variables
#   - Parameters follow local-variable rules

# Variable Creation & Assignment:
#   - Variables must be created using let
#   - Assignment without let modifies an existing variable
#   - Attempting to assign to a variable that does not exist causes a compile error
#   - let cannot be used to modify an existing variable

# Mutability:
#   - Variables are immutable by default
#   - Variables must be declared with mut to allow reassignment
#   - Attempting to modify a non-mut variable causes a compile error
#   - Mutability rules apply equally to globals, locals, class fields, and parameters

# Shadowing:
#   - Local variables may use the same name as global variables
#   - This is called shadowing
#   - When shadowed, the global variable becomes inaccessible
#   - All reads and writes affect the local variable
#   - When the local variable is dropped, access returns to the global variable
#   - There is no syntax to access a hidden global variable while a local shadow exists

# Function Parameters:
#   - Function parameters behave as local variables
#   - Parameters may shadow global variables
#   - Parameters are automatically dropped when the function returns
#   - Parameters follow normal mutability rules
#   - Parameters do not enter the global memory pool

# Types:
#   - Type checking happens at compile time
#   - Null is valid for every type
#   - Any can store any value type
#   - Assigning an incompatible type causes a compile error
#   - Unknown or missing symbols raise compile errors (error if fn/class not found)
#   - Reassignment rules depend on mut (non-mut = compile error)
#   - Not all errors are runtime; many are compile-time by design
#   - Variables, functions, classes, and namespaces must have unique names within a scope
#   - Duplicate symbol definitions cause compile errors

# Null:
#   - Null represents an existing value with no data
#   - Null can be compared using == and !=
#   - Null is considered smaller than all non-null values
#   - Example: Null < 0 is True
#   - Null comparisons are valid and well-defined across types

# Collections:
#   - Collections require mut to be modified
#   - list   = ordered sequence of values
#   - index  = key -> single scalar value map (never a collection)
#   - dict   = key -> collection map
#   - dict+  = key -> nested dict+ map (unlimited nesting depth)
#   - .len() returns the number of items
#   - .has() checks for keys or values
#   - Accessing a missing key or index causes a runtime error
#   - Iteration behavior:
#       * list   -> values
#       * index  -> keys
#       * dict   -> keys
#       * dict+  -> keys
#       * file   -> lines
#   - Collections use deep copy on assignment
#   - You can force collection types: let x: list: i32 = [0, 10, 32]
#   - .set() and .add() completely replace Null values
#   - If a target contains Null, the Null value is destroyed
#     and the new value takes its place
#   - Null is never preserved after replacement
#   - For lists and dict value collections, .add() appends normally
#     and does not remove existing values
#   - The exception is when a collection contains only a single Null value
#   - In that case, .add() replaces the Null instead of appending
#
#     [Null].add(5)
#     # Result: [5]
#
#     [1, Null].add(5)
#     # Result: [1, Null, 5]

# Collection Equality:
#   - Collection equality compares contents
#   - Two collections with identical contents are equal
#   - Equality is checked recursively
#   - Null values inside collections are valid and comparable

# Strings:
#   - Strings are zero indexed
#   - .len() returns number of characters
#   - .char(index) returns character at index
#   - .set(index, value) replaces a character
#   - .set() requires a single-character string
#   - .insert(index, value) inserts text before index
#   - .replace(old, new) replaces all matches
#   - .slice() returns list of characters
#   - String modification requires mut
#   - Strings are iterable in loops

# Loops:
#   - Loop variable names can be anything
#   - Loop variables are local to the loop
#   - Loop variables are automatically dropped after the loop
#   - Lists yield values
#   - Indexes yield keys
#   - Dicts yield keys
#   - Files yield lines
#   - User-defined classes cannot define custom iteration behavior
#   - Loop variables are not persistent outside loop scope

# Range:
#   - range(start, end) excludes the end value
#   - If start < end, counts upward
#   - If start > end, counts downward

# Indexes:
#   - Iteration preserves insertion order
#   - Keys can be any type (not just strings)

# Classes:
#   - Class names must be unique within a scope
#   - Duplicate class definitions cause compile errors
#   - Class instances follow normal deep-copy rules
#   - Assigning one instance to another creates a full copy
#   - Class fields marked mut may be modified
#   - Non-mut fields cannot be modified
#   - No "self" keyword; fields are accessed directly
#   - Methods operate on instance state implicitly
#   - No self parameter is required
#   - Class fields may be accessed directly from inside class methods
#   - Attempting to modify locked fields causes compile error

# Threads:
#   - Threads share access to global variables
#   - Multiple threads may modify the same variable
#   - No race-condition protection is provided
#   - Invalid memory access causes runtime error
#   - Thread IDs are required for control and synchronization
#   - Global variables are shared by all threads
#   - Function parameters are private to the executing thread
#   - Local variables are private to the executing thread
#   - Loop variables are private to the executing thread
#   - Shadowing rules work the same inside threads
#   - Accessing a global variable inside a thread accesses the shared global variable
#   - Modifying shared globals from multiple threads may produce undefined results

# Imports:
#   - use enables built-in modules
#   - import loads external .vire files
#   - Imported files are accessed through their namespace
#   - import can be renamed with 'as' (import x as y)
#   - A plain import shares ONE instance of that file's state across
#     every importer; 'import local' gives just this file its own
#     private instance (see IMPORTS / SHARED VS LOCAL IMPORTS)
#   - Built-in modules and imported namespaces are separate systems
#   - Missing imports or symbols result in compile errors

# Files & Memory Notes:
#   - open() blocks auto-close file handles
#   - File variables persist after block ends
#   - File operations support try/error handling
#   - File iteration yields lines only inside open scope

# Errors:
#   - Compile errors prevent the program from running
#   - Runtime errors occur during execution
#
# Compile Error Examples:
#   - Unknown variable
#   - Unknown function
#   - Unknown class
#   - Unknown namespace
#   - Type mismatch
#   - Mutability violation
#   - Duplicate symbol definition
#   - Invalid assignment target
#
# Runtime Error Examples:
#   - Divide by zero
#   - Invalid index access
#   - Missing collection key
#   - Accessing dropped memory
#   - Invalid file operations
#   - Invalid FFI calls
#
# General Rules:
#   - Attempting to modify a non-mut value causes a compile error
#   - Accessing null behaves as a valid but empty state
#   - Missing symbols are detected at compile time when possible

# Local Variables:
#   - Declared using 'local'
#   - Syntax: let mut local x: type = value
#   - Exist only inside the current block or function
#   - Automatically dropped at scope exit
#   - Cannot be accessed outside their scope
#   - May shadow global variables
#   - Do not enter the global pool
#   - Follow normal mutability rules

# Integer Overflow:
#   - When an operation exceeds the maximum or minimum value of a
#     type, the value stays clamped at that max/min — it does not
#     wrap around.
#   - A non-fatal runtime error is raised to flag this, but unlike
#     other runtime errors, it does NOT require a try/error block —
#     the program always keeps running with the clamped value.
#   - Overflow errors are reported once per operation.
#   - The clamped result is stored before execution continues.

