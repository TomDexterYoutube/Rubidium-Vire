# =========================================
# EXECUTION MODEL
# =========================================

# VIRE is for FFI compatibility with Rubidium

# nothing top level runs the only time something runs is if the fn is called

# the only exception is FFI libs being loaded


# =========================================
# DATA TYPES
# =========================================

# -----------------------------------------
# Rubidium
# -----------------------------------------

# Integers (signed):
#   i32, i64, i128, i256, i512, i1024, i2048

# Floats:
#   f32, f64, f128, f256, f512, f1024, f2048

# Other:
#   str   — text string
#   str+  — a string but uses 3 " on each side
#   bool  — True or False
#   Null  — valid for all types, means "exists but empty"
#   Any   — can hold a value of any type
#   SY    — Holds a string that can be used in code

# Collections:
#   list
#   index
#   dict
#   dict+  — like dict, but values are nested dicts instead of lists (unlimited depth)

let a: i32  = 100
let b: f64  = 3.14
let c: str  = "hello"
let d: bool = True
let e: i32  = Null
let f: Any  = "I can be anything!"

# Any can be used when you don't know the type in advance, for functions, return types and such

# -----------------------------------------
# LIB
# -----------------------------------------

# C primitive types (alias mapping for interoperability / reference):
# - integer types
#   char        — 8-bit integer (signed or unsigned implementation-defined)
#   signed char — explicitly signed 8-bit
#   unsigned char — explicitly unsigned 8-bit
#   short       — at least 16-bit signed
#   unsigned short — at least 16-bit unsigned
#   int         — at least 16-bit signed (commonly 32-bit)
#   unsigned int — at least 16-bit unsigned
#   long        — at least 32-bit signed (commonly 64-bit on LP64)
#   unsigned long — at least 32-bit unsigned
#   long long   — at least 64-bit signed
#   unsigned long long — at least 64-bit unsigned
#
# - fixed-width integer types (from stdint.h)
#   int8_t, uint8_t
#   int16_t, uint16_t
#   int32_t, uint32_t
#   int64_t, uint64_t
#   int128_t, uint128_t (where supported)
#
# - other integer types
#   size_t      — unsigned type for sizes
#   ptrdiff_t   — signed type for pointer differences
#   intptr_t, uintptr_t — integer types guaranteed to hold a pointer
#
# - floating point types
#   float       — typically 32-bit
#   double      — typically 64-bit
#   long double — extended precision (implementation-defined)
#
# - pointer and special types
#   void*       — pointer to unknown, opaque DATA
#   ptr         — a raw, already-resolved FUNCTION-pointer-shaped address
#                 (e.g. from glXGetProcAddress) — see FFI's `fn ptr raw(...)`.
#                 Same representation as void*, kept as its own name so a
#                 declaration reads as "this is meant to be called through",
#                 not "this is opaque data".
#   NULL        — null pointer constant
#   _Bool / bool — boolean type (0 or 1)
#
# Notes:
# - Use unsigned variants for non-negative values where overflow behavior matters.
# - For fixed-width guarantees across platforms, prefer stdint.h types (int32_t, etc.).
# - Interfacing with C libraries should follow the platform ABI and sizes.
#
# WHICH LIB TYPES NEED NO CONVERSION: these are BIT-FOR-BIT the same
# representation as an existing Rubidium type, so a Rubidium value of that
# type is already directly usable as that LIB type in an FFI signature —
# no cast.X()/retrieve.X() needed or offered (see CONVERSION's "no-op
# casts are rejected"):
#   int, unsigned int, int32_t, uint32_t         <-> i32
#   long, unsigned long, long long,
#     unsigned long long, int64_t, uint64_t,
#     size_t, ptrdiff_t, intptr_t, uintptr_t     <-> i64
#   int128_t, uint128_t                          <-> i128
#   float                                        <-> f32
#   double                                       <-> f64
# Everything else (char/short and their unsigned/signed variants, long
# double, void*/char*/ptr) has no matching native Rubidium type at that
# exact width/shape and genuinely needs cast.X()/retrieve.X() to cross.

# You can only do Vire code in Rubidium types — see CONVERSION below for
# how to move values between Vire and lib types.

# -----------------------------------------
# STRUCT
# -----------------------------------------

# Some C APIs hand you (or want from you) a fixed-layout block of memory
# with named fields at exact byte positions — GLFWvidmode, a vertex struct
# you define yourself, and so on. `struct` describes that shape: a name and
# a LIB type per field, in declaration order. No methods, no `mut` on
# fields — every field is always readable/writable, the same as a raw C
# struct. Not the same thing as `class`: a class instance is a Rubidium
# object with Rubidium's own memory bookkeeping; a struct is raw memory
# laid out exactly the way C would lay it out, nothing more.

struct GLFWvidmode {
    width: int
    height: int
    redBits: int
    greenBits: int
    blueBits: int
    refreshRate: int
}

# Two ways to get an instance — both act like a stripped-down class (name
# the type, read/write `.field`), not like a list:

# 1. Fresh, zeroed, owned — same call syntax as instantiating a class:

let mut mode = GLFWvidmode()
mode.width = 1920
mode.height = 1080

# 2. A VIEW over a pointer a C function already gave you — no allocation,
# no copy, just a differently-typed handle on the exact same address. Give
# the variable its type explicitly; the value is whatever pointer you're
# viewing:

let glfw = FFI("libglfw.so")
fn glfw glfwGetVideoMode(monitor: void*) -> void* as get_video_mode

let ptr = get_video_mode(primary_monitor)
let live_mode: GLFWvidmode = ptr

print(live_mode.width)    # reads directly out of GLFW's own memory

# Passing a struct's address to a raw C function needs no extra syntax —
# an owned struct variable already IS its address, same as a class
# instance, so it binds straight into a `void*` parameter:

fn glfw glfwSetGamma(monitor: void*, gamma: float) as set_gamma
# some_fn(mode) where some_fn's param is void* — just works


# =========================================
# VARIABLES
# =========================================

# Declare with 'let'. Type is optional — Rubidium infers it.

let x = 10
let name = "Rubidium"
let flag = True

# Use 'mut' if you need to reassign the variable later.

let mut counter = 0
counter = 5

# Trying to reassign a non-mut variable is a compile error.

let a = 10
a = 20   # ERROR: a is not mutable


# =========================================
# THE VARIABLE OVERWRITE RULE
# =========================================

# If you declare a variable
let mut x: i32 = 10

# Then you can edit it since its mut

x = 15

# But you don't use let to change it
# IF you use let

let x = "Hi"

# And if a variable with that name already exists, then it drops it
# Then recreates it as a new variable


# =========================================
# SCOPE
# =========================================

# The different scopes can have slightly different rules

while True {
    let local num = 10
    break
}

# When the block ends, the local is dropped. This holds true for:
#   - for loops
#   - functions
#   - while loops
#   - if blocks


# =========================================
# MEMORY MODEL
# =========================================

# All variables live in a SHARED GLOBAL POOL.
#
# Rules:
# - Variables are visible everywhere once created.
# - There is no automatic memory management.
# - Memory must be freed manually using .drop().
# - The only exceptions are open() file blocks and loop variables,
#   which are freed automatically at the end of their block.
#
# Think of memory as a shared whiteboard —
# everyone can see and modify it.


# =========================================
# GLOBAL BY DEFAULT
# =========================================

# Variables created normally are placed into the global memory pool.

let score = 100

# Global variables can be accessed anywhere.
# Local variables must be declared explicitly.
# Full syntax (mut is optional, only needed if reassigning later):
#   let mut local name: type = value

let local temp = 100

# Local variables never enter the global pool
# and are automatically dropped when their scope ends.


# =========================================
# THE DEEP COPY RULE
# =========================================

# Assigning one value to another creates a complete deep copy.

let mut a = [1, 2, 3]
let mut b = a

# a and b are completely independent.
# Rubidium does not use references, borrowing, or shared ownership
# BY DEFAULT — the only exception is the explicit 'link' keyword,
# which opts a specific variable into sharing (see THE LINK RULE).


# =========================================
# NULL BEHAVIOR
# =========================================

# Null is a valid value for every type.

let value: i32 = Null

# Null is considered smaller than every non-null value.
# Conceptually, Null behaves like negative infinity.

Null < 0         # True
Null < -999999   # True
Null == Null     # True


# =========================================
# MEMORY — DROPPING VARIABLES
# =========================================

# .drop() frees a variable's memory immediately.
# The variable no longer exists after being dropped.
# Collections recursively free all nested data.

let val = 42
val.drop()

let mut items: list = [1, 2, 3]
items.drop()

# You can remove a specific variable in a collection
# It removes it and shifts the structure it DOES NOT replace it with Null

items(1).drop()


# =========================================
# TYPE CASTING
# =========================================

# Use 'as' to cast between types.

let y: i32 = 5
let large: i64 = y as i64
let f: f64 = 100 as f64


# =========================================
# TYPE CHECKING
# =========================================

# Rubidium checks types at compile time.
# Assigning the wrong type raises a compiler error.

# Example (will NOT compile):
# let val: i32 = 5
# val = "hello"   # ERROR: wrong type


# =========================================
# MATH
# =========================================

# Standard operators:
#   +   addition
#   -   subtraction
#   *   multiplication
#   /   division
#   **  power
#   */  root
#   %   remainder

let a = 10 + 5       # 15
let b = 10 - 5       # 5
let c = 10 * 5       # 50
let d = 10 / 5       # 2
let e = 2 ** 3       # 8
let f = 2 */ 16      # 4
let g = 2 % 10       # 2

# Standard BODMAS precedence applies.

let g = 1 + 2 * 3    # 7
let h = (1 + 2) * 3  # 9

# Negate a value with a leading minus.

let x = 10
let y = -x           # -10

# -------------------------------
# TYPED MATH BLOCKS
# -------------------------------

# A parenthesised math expression can be given a result type with `: TYPE`
# right after the closing bracket. The WHOLE expression inside is then
# computed at that type's precision — not just the final value cast.

let r = (10 / 3): f64        # 3.3333...  (division done as f64, not int)

# This is the difference from a plain group: `(10 / 3)` alone divides two
# integers and gives 3; `(10 / 3): f64` computes the division at f64.

# Per-operand `as` casts still apply — they convert each operand first,
# then the block type governs every operation's result:

let s = (10 as i32 / 3 as i32): f2048   # operands are i32 (10, 3), but the
                                        # division runs at f2048 -> 3.3333...

# Use a wide float type for high-precision math:

let big = (22 / 7): f2048    # pi approximation computed at f2048 precision

# An integer block type keeps integer arithmetic:

let d = (10 / 3): i32        # 3

# Normal BODMAS precedence still applies inside the block:

let e = (1 + 2 * 3): f64     # 7.0

# Blocks can nest; each block's type governs its own operations:

let n = ((10 / 3): f64 + 1): f2048   # 4.3333...


# =========================================
# COMPARISON & LOGIC
# =========================================

# Comparison operators:
#   ==  equal
#   !=  not equal
#   >   greater than
#   <   less than
#   >=  greater than or equal
#   <=  less than or equal

let check: bool = 10 > 5   # True

# Logical operators:
#   and
#   or
#   not

let result: bool = True and not False   # True


# =========================================
# STRINGS
# =========================================

# Strings store text.

let text = "Hello World"

print(text)

# Output:
# Hello World


# Strings use double quotes.

let name = "Max"
let message = "Welcome to Rubidium"


# Empty string

let empty = ""


# Strings can contain numbers and symbols.

let text = "abc123!@#"


# -------------------------------
# STRING METHODS
# -------------------------------

# Get a character at an index.

text.char(index)

let text = "Hello"

print(text.char(0))

# Output:
# H

print(text.char(4))

# Output:
# o

# Replace a character at an index.

text.set(index, value)

let mut text = "Hello"

text.set(0, "J")

print(text)

# Output:
# Jello

# value must be a single character string.

text.set(4, "!")

print(text)

# Output:
# Hell!

# Insert text before an index.

text.insert(index, value)

let mut text = "Hello"

text.insert(5, "!")

print(text)

# Output:
# Hello!


let text = "World"

text.insert(0, "Hello ")

print(text)

# Output:
# Hello World


# Replace every matching character or string.

text.replace(old, new)

let mut text = "banana"

text.replace("a", "_")

print(text)

# Output:
# b_n_n_


let text = "Hello World"

text.replace("World", "Rubidium")

print(text)

# Output:
# Hello Rubidium


# Convert a string into a list of characters.

text.slice()

let text = "Hello"

print(text.slice())

# Output:
# ["H", "e", "l", "l", "o"]

let text = "Hello"

print(text.len())

# Output:
# 5


# =========================================
# SY
# =========================================

# SY type is like a string but can be used in code

let variable_name: SY = 'New variable'
let (variable_name): str = "Hello I'm a variable"

let function_name: SY = 'New function'

fn (function_name)() {
    print("I'm a new Function")
}

# You put () around the SY when its used and ' when its made


# =========================================
# STR+
# =========================================

# str+ is the same as str but it uses 3 " and can use more then 1 line

let my_str_plus: str+ = """
Hello
I'm a big string!
"""


# =========================================
# COLLECTIONS
# =========================================

# All three collection types (list, index, dict)
# require 'mut' if you want to modify them.

# -----------------------------------------
# LIST
# -----------------------------------------

# An ordered sequence. Zero-indexed.

let mut my_list: list = ["hello", 2.5, True]

# Access by index:

print(my_list(0))   # hello

# Mutate an item using .set():

my_list(0).set("changed")

# Append a new item using .add():

my_list().add("new_item")

# when a list is printed it shows text in "" and everything else as is
let my_list = "Hello".slice() + [1, 2, 3]
print(my_list) # ["H", "e", "l", "l", "o", 1, 2, 3]

# -----------------------------------------
# LIST UTILITIES
# -----------------------------------------

# .combine() joins all values together.

let words = ["Hello", " ", "World"]

print(words.combine())

# Output:
# Hello World

# -----------------------------------------
# INDEX
# -----------------------------------------

# A flat key-value map.
# Keys can be any type. Values must be a single SCALAR (i32/f64/str/bool/
# Null/etc) — never a list, index, dict, or dict+. Use `dict` instead if a
# key needs to hold a collection of values.

let mut my_index: index = [
    "name": "Rubidium",
    1: "one",
    2.5: "float key"
]

# Access by key:

print(my_index("name"))   # Rubidium

# Mutate a value using .set():

my_index("name").set("updated")

# Add a new key-value pair using .add():
# If the key already exists, this will error.

my_index().add("new_key", 99)

# -----------------------------------------
# DICT
# -----------------------------------------

# A key-value map where each key holds
# a collection of multiple values.

let mut my_dict: dict = {
    "scores" = [10, 20, 30],
    "names"  = ["alice", "bob"]
}

# Access a specific value inside a key:
# dict(key, index)

print(my_dict("scores", 1))   # 20

# Mutate a value using .set():

my_dict("scores", 1).set(999)

# Add a value to an existing key's collection:

my_dict("scores").add(40)

# Add a new top-level key:
# The new key is created with value Null.

my_dict().add("new_key")

# -----------------------------------------
# DICT+
# -----------------------------------------

# dict+ is like dict, but a key's value can be
# either a list (a leaf, same as normal dict)
# or another dict+ (a further level of nesting).
# There is no limit on how many levels deep this can go.

let mut my_dictplus: dict+ = {
    1 = {
        "test" = [1, 2, 3, 4]
    }
}

# Access a value by chaining keys down through each level:
# dictplus(key1, key2, ...) — keeps drilling down until
# it reaches a list, then behaves like a normal dict from there.

print(my_dictplus(1, "test"))          # [1, 2, 3, 4]
print(my_dictplus(1, "test", 0))       # 1

# Add a value to the list at the end of the path:

my_dictplus(1, "test").add("ten")

# Add a new key at any level.
# Give it a list to make it a leaf, or a { } block to nest further:

my_dictplus(1).add("other", [5, 6, 7])
my_dictplus(1).add("deeper", { "layer2" = [8, 9] })

# Add a new top-level key:
# The new key is created as an empty dict+.

my_dictplus().add(2)

# -----------------------------------------
# NAMING NOTE
# -----------------------------------------

# Keys still follow the same rules as index/dict —
# strings need quotes ("test"), numbers and other
# types do not.


# =========================================
# PRINT & INPUT
# =========================================

# print() — outputs text and moves to a new line.

print("Hello, Rubidium!")
print(x)
print(i"Value is {x}")
print("Count: " + x)

# println() — overwrites the current console line.
# Calling it again replaces the previous output.

println("Loading...")
println("Done!")
# The console shows: Done!

# input() — reads a line of text from the user.

let user: str = input("Enter your name: ")

# clear() — wipes the WHOLE terminal screen, not just the current line
# (that's println()'s job). Takes no arguments.

print("Hello!")
clear()
print("You won't see 'Hello!' anymore — the screen is blank now.")

# exit([code]) — terminates the running binary immediately and
# unconditionally, from anywhere in the program (not just main()).
# No cleanup, no unwinding, no drop()s run — the process just ends,
# the same as an ordinary process exit with that status code.
# code is optional and defaults to 0.

fn check(n: i32) {
    if n < 0 {
        print("negative — stopping")
        exit(1)
    }
    print("still running")
}

check(-1)
print("this line never runs")

# exit() with no arguments exits with status 0:

exit()


# =========================================
# FILES
# =========================================

# Open a file using 'open() as'.
# The file automatically closes at the end of the block.
# Any variables created inside the block persist,
# but the file handle is gone after the closing brace.

open("data.txt") as file {

    file.write("Hello")        # overwrite entire file
    file.add(" World")         # add to end of file

    let data = file.read()     # read entire file (would be the str+ type)
    print(data)

    let line = file.readln(3)  # read a specific line
    print(line)

    file.writeln(2, "Updated") # overwrite a specific line
}

# Line indexing starts at 0
# Iterate over a file line by line:

open("data.txt") as file {
    for line in file {
        print(line)
    }
}

# If the file does not exist, open() creates it, raises a
# (non-fatal, catchable) error, and then continues.

# File utility functions (used outside of open blocks):

file.exists("data.txt")              # returns bool
file.new("data.txt")                 # create a new file
file.delete("old.txt")               # delete a file
file.rename("old.txt", "new.txt")    # rename a file
file.copy("save.txt", "backup.txt")  # copy a file
file.list("data/")                   # used like linux ls command

# File errors can be caught with try/error:

try {
    open("missing.txt") as file {
        print(file.read())
    }
} error {
    print("File error: " + error)
}

# missing.txt is created either way — the try/error block
# just lets you catch and handle the "file did not exist" error.


# =========================================
# CONDITIONALS
# =========================================

let x = 7

if x == 7 {
    print("lucky seven")
} else if x > 10 {
    print("big number")
} else {
    print("something else")
}

# The else must be on the } end of the if or other else


# =========================================
# LOOPS
# =========================================

# While loop:

let mut count = 0

while count < 5 {
    print(count)
    count = count + 1
}


# =========================================
# RANGE LOOP
# =========================================

# range(start, end) — end is exclusive.

# The loop variable is local to the loop only.
# It can be named anything and is automatically
# dropped when the loop ends.

for i in range(1, 10) {

    if i == 5 {
        break
    }

    print(i)
}

# The loop variable name is not special.

for value in range(1, 10) {
    print(value)
}

for banana in range(1, 10) {
    print(banana)
}

# Loop indexing starts at 0


# =========================================
# COLLECTION ITERATION
# =========================================

# Lists, indexes, dicts, and files can be
# used directly in for loops.

# Loop variables are always local to the loop
# and are automatically dropped after execution.

let items: list = [10, 20, 30]

for item in items {
    print(item)
}

for number in items {
    print(number)
}

# -----------------------------------------
# INDEX ITERATION
# -----------------------------------------

# Iterating an index yields keys.

let table: index = [
    "name": "Rubidium",
    "lang": "Programming"
]

for key in table {
    print(key)
    print(table(key))
}

# -----------------------------------------
# DICT ITERATION
# -----------------------------------------

# Iterating a dict yields keys.

let scores: dict = {
    "players" = ["Alice", "Bob"],
    "points" = [10, 20]
}

for key in scores {
    print(key)
    print(scores(key, 0))
}

# -----------------------------------------
# FILE ITERATION
# -----------------------------------------

# Iterating a file yields lines.
# The file handle remains valid only inside
# the open block scope.

open("data.txt") as file {

    for line in file {
        print(line)
    }
}


# =========================================
# BREAK & CONTINUE
# =========================================

# break exits the loop immediately.

for i in range(1, 10) {
    if i == 5 {break}
    print(i)
}

# continue skips the current iteration.

for i in range(1, 10) {
    if i == 5 {continue}
    print(i)
}


# =========================================
# FUNCTIONS
# =========================================

# Functions share the global memory pool.

# Function parameters are local to the function
# and are automatically dropped when the function returns.

# Basic function:

fn greet() {
    print("Hello!")
}

# With parameters:

fn add(a: i32, b: i32) -> i32 {
    return a + b
}

let result = add(2, 3)   # 5

# Return type is optional.
# A function with no return type returns nothing.

fn log(msg: str) {
    print(i"[LOG] {msg}")
}

# -----------------------------------------
# DEFAULT PARAMETER VALUES
# -----------------------------------------

# A parameter can declare a default with `= value` right after its type.
# A call that omits it uses the default instead.

fn test(x: i32 = 10, y: i32 = 20, b: i32 = 1) {
    print(x)
    print(y)
    print(b)
}

test()   # 10, 20, 1 — every default used

# Parameters WITHOUT a default must all come before the ones that have one
# — same rule as most languages, so trailing arguments can still be left
# out and filled positionally without naming them:

fn add(a: i32, b: i32 = 5) -> i32 {
    return a + b
}

add(7)      # 12 — b uses its default
add(7, 3)   # 10 — b explicit

# fn add(a: i32 = 1, b: i32) { ... }   # ERROR: 'b' has no default but
#                                      # follows one that does

# -----------------------------------------
# NAMED ARGUMENTS
# -----------------------------------------

# A call can bind arguments by parameter name instead of position, in any
# order — not just for skipping defaults, works for required parameters too:

test(x = 100, y = 4, b = 9)
test(b = 9, x = 100, y = 4)   # same call, any order

# Positional and named arguments can mix, but every positional argument
# must come BEFORE any named one (it fills the next unbound parameter in
# declaration order; a named one after that could bind the same slot twice
# with no clear rule for which wins):

add(7, b = 3)      # OK — 7 positional for 'a', 3 named for 'b'
# add(a = 7, 3)    # ERROR: positional argument follows a named one

# Naming a parameter that doesn't exist, naming the same parameter twice
# (once positionally and once by name, or twice by name), or leaving a
# parameter with no default unfilled are all compile errors:

# add(c = 1)         # ERROR: no parameter named 'c'
# add(1, a = 2)      # ERROR: multiple values for parameter 'a'
# fn needs_two(a: i32, b: i32) {}
# needs_two(a = 1)   # ERROR: missing required argument 'b'

# Default values and named arguments work the same way for class methods
# (see CLASSES below) — declared on the method's own parameter list, bound
# the same way at the call site (p.method(x = 1)).


