# IMPORTS
# =========================================

# import loads another .vire file and exposes it through a namespace
# named after the file.

import helper

helper.some_fn()
print(helper.shared_num)

# Give the namespace a different name with 'as':

import math_tools as mt

mt.sin(1.0)

# -----------------------------------------
# SHARED VS LOCAL IMPORTS
# -----------------------------------------

# By default, import shares ONE instance of the imported file's state
# across every file that imports it. If file A and file B both plain
# `import helper`, they are looking at the same helper.shared_num —
# a change either one makes is visible to the other.

import helper

helper.shared_num = 42   # visible to every other file that imported helper normally

# 'import local' instead gives THIS file its own private instance of the
# imported file's state. Changes made through it are invisible to every
# other importer — including other 'import local' importers, who each get
# their own separate instance too.

import local helper

helper.shared_num = 42   # only visible inside this file

# This choice also determines what 'link' sees when linking through the
# namespace (see LINK ACROSS FILES below): link follows whichever instance
# the namespace refers to, so linking through a plain import reaches the
# shared instance, and linking through an 'import local' reaches that
# file's private one.


# =========================================
# THE LINK RULE
# =========================================

# Say you have a variable that is a local val and it is large
# And you want another function to use it but you don't want to deep copy the large value
# Then use link

fn stuff(val: Any) -> Any {
    val.add(7)
}

fn main() {
    let local large_list: list = ["Lots of Data"]
    stuff(link large_list)
}

# This would let the function stuff access the local variable without a deep copy
# Both functions are now using the same variable both have full access if it is mut both can edit it

# If you love pain (rust) then you can use link for variables

let a = 10

let b = link a

# Now if a changes then b will change but if b changes without a then they become unlinked
# then become there own variable in memory this also works for lists

let x = [1, 2, 3]
let y = link x(2)

# or

let x = [1, 2, 3]
let y = link x

# -----------------------------------------
# LINK ACROSS FILES
# -----------------------------------------

# link works through a namespace exactly as it does inside one file.
# It links to whichever INSTANCE that namespace refers to, so a plain
# import links to the shared one and an 'import local' links to that
# file's private one (see SHARED VS LOCAL IMPORTS).

import helper

let mut view = link helper.shared_list   # link a module's collection
let s        = link helper.shared_num    # link a module's scalar
let el       = link helper.shared_list(2)  # link one element of it

# All three track the module's later changes:

helper.shared_num = 42
print(s)                 # 42

# A module's variable can also be passed by link into another module:

helper.append_to(link my_list)

# Editing a linked collection still needs 'mut' on the linked name,
# the same rule as any other collection:

let mut editable = link helper.shared_list
editable().add(9)


# =========================================
# ERROR HANDLING
# =========================================

# Use try/error to catch runtime errors.
# The error variable holds the error message as a str+.

try {
    let bad: i32 = 10 / 0
} error {
    print("Error: " + error)
}

# try/error works with file operations too (see FILES section).

# Use raise to manually trigger a runtime error with a custom message.
# If raise runs inside a try block — directly, or inside a function called
# from within that try — the nearest enclosing try's error handler catches
# it (the message becomes the `error` variable). Outside of any try, raise
# halts the program with the message.

fn check(n: i32) {
    if n < 0 {
        raise "n must not be negative"
    }
}

try {
    check(-1)
} error {
    print("Error: " + error)   # Error: n must not be negative
}


# =========================================
# CLASSES
# =========================================

# A class is a self-contained object template.
# There is no 'self' keyword — class variables are
# accessed directly from inside the class.

class player() {

    let mut health: i32  = 100
    let mut name: str    = "unnamed"
    let mut scores: list = [0, 0, 0]

    fn greet() {
        print(i"Hi, I am {name}")
    }

    fn take_damage(amount: i32) {
        health = health - amount
    }

    fn reset_scores() {
        # Inside the class, collection fields are accessed directly
        # without the instance name — just like non-collection fields.
        scores(0).set(0)
        scores(1).set(0)
        scores(2).set(0)
        scores().add(0)
    }
}

# Create an instance:

let mut p = player()

# Read class fields:

print(p.health)   # 100

# Mutate a non-collection field using =:
# The instance must be declared with mut.

p.health = 80
p.name   = "Alice"

# Mutate a collection field using .set():
# From outside the class, prefix with the instance name.

p.scores(0).set(99)

# From inside a class method, access directly without the instance name.
# See reset_scores() in the class definition above.

# Append to a collection field using .add():

p.scores().add(50)

# Call a class method:

p.greet()
p.take_damage(10)

# Mutation rules:
# - If the instance is immutable (no mut), nothing can be changed.
# - If the instance is mutable (mut), only fields declared
#   with 'mut' inside the class can be changed.

class locked() {
    let value: i32 = 42     # can never be changed from outside
}

let mut obj = locked()
obj.value = 99   # ERROR: value is not declared mut

# -----------------------------------------
# CLASS MEMORY MODEL
# -----------------------------------------

# Class instances do not store their fields
# in the global memory pool.
# Each instance owns its own data.

let mut a = player()
let mut b = player()

a.health = 50

print(b.health) # 100

# Assigning one instance to another creates
# a complete deep copy.

let mut a = player()
let mut b = a

b.health = 10

print(a.health) # 100
print(b.health) # 10

# Classes can not access global memory unless link is used or passed through


# =========================================
# THREADING
# =========================================

# Rubidium supports real POSIX hardware threads.

use thread

fn task_one() {
    print("Task one done")
}

fn task_two() {
    print("Task two done")
}

fn run() {

    # thread(function(), id) — runs function asynchronously.
    # Thread IDs are integers, like timer IDs.
    # A thread ID can only be reused after that thread has finished.

    thread(task_one(), 1)
    thread(task_two(), 2)

    # thread.wait(id, ...) — blocks until all listed threads finish.

    thread.wait(1, 2)

    # thread.running(id) — returns True if the thread is still running.

    let still_going: bool = thread.running(1)
}

# Threading creates a scope with special rules.

fn task_worker(x) {
    let local y = 10
    print("done")
}

let z = 10

fn main() {
    thread(task_worker(1), 1)
    thread(task_worker(1), 2)
}

# y is local, so each thread shares z but
# has its own x and y.

# when you need to stop something

thread.kill(1)

# thread.kill(id) stops that thread immediately — even mid-loop with no
# other work in it (meant for loops, but can be used anywhere). Killing an
# id with no thread running on it is a harmless no-op. Once killed, the id
# is free to reuse with a new thread(...) call, same as a thread that
# finished on its own.

# -----------------------------------------
# THREAD SCOPE RULES
# -----------------------------------------

# Threads share the global memory pool.

# Any global variable can be read or modified by any thread.

let counter = 0

# All threads can access counter.

# -----------------------------------------
# THREAD-LOCAL DATA
# -----------------------------------------

# Function parameters and local variables belong only to the
# thread currently executing them.

fn worker(id) {
    let local temp = 10

    print(id)
    print(temp)
}

# Every thread receives its own copy of:
#   - Function parameters
#   - Local variables
#   - Loop variables
#
# These values are never shared between threads.

# -----------------------------------------
# SHARED DATA
# -----------------------------------------

# Global variables are shared.

let total = 0

fn add() {
    total = total + 1
}

# If multiple threads modify the same global variable at the same
# time, the result is undefined. Rubidium provides no automatic
# race condition protection.

# -----------------------------------------
# AUTOMATIC CLEANUP
# -----------------------------------------

# When a thread finishes:
# - Function parameters are dropped
# - Local variables are dropped
# - Loop variables are dropped
# - Global variables remain alive.

# -----------------------------------------
# THREAD MEMORY MODEL
# -----------------------------------------

# Variable Type       Shared?
# Global Variable     Yes
# Function Parameter  No
# Local Variable      No
# Loop Variable       No
# File Handle         No

# Simple rule: If it is in the global pool, it is shared.
# Otherwise it belongs only to the currently executing thread.


